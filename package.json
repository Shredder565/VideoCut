{
  "name": "videocut",
  "productName": "VideoCut",
  "version": "0.1.0",
  "description": "Frame-accurate video cutting, recording repair, ad detection and joining",
  "author": "Shredder565",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --win dir --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "42.11.15",
    "electron-builder": "26.16.1",
    "esbuild": "^0.25.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "typescript": "^5.9.0",
    "vite": "7.3.5",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
