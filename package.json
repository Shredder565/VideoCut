{
  "name": "videocut",
  "productName": "VideoCut",
  "version": "0.1.0",
  "description": "Frame-accurate video cutting, recording repair, ad detection and joining",
  "author": "Shredder565",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "42.11.15",
    "electron-builder": "26.16.1",
    "esbuild": "^0.25.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "typescript": "^5.9.0",
    "vite": "7.3.5",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "build": {
    "appId": "io.github.shredder565.videocut",
    "productName": "VideoCut",
    "copyright": "Copyright © 2026 Shredder565",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "ffmpeg/win-x64",
        "to": "ffmpeg"
      },
      {
        "from": "NOTICE.txt",
        "to": "NOTICE.txt"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "VideoCut-portable-win-x64.exe"
    },
    "artifactName": "VideoCut-win-x64.${ext}"
  }
}
